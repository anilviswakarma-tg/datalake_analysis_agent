# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Google Gemini (free tier) ─────────────────────────────────
# Used by the "Gemini 2.5 Flash (Google)" entry in the model dropdown, via
# Google's OpenAI-compatible endpoint. Get a key at aistudio.google.com/apikey.
# Bedrock models need no key (they use SigV4 / the IAM role) — this is only
# for the OpenAI-compatible vendors.
GEMINI_API_KEY=
# The dropdown label is derived from this value, so bumping it here is enough.
GEMINI_MODEL=gemini-3.6-flash

# ── AWS ───────────────────────────────────────────────────────
# Leave AWS_PROFILE empty on EC2 — the instance IAM role is used automatically.
AWS_PROFILE=
AWS_REGION=us-west-2

# IMDS (instance metadata) timeout/retry tuning. Defaults are 1s/1 attempt,
# which can be too tight for a busy long-running container fetching EC2
# instance-role credentials over the Docker network path — bump both to
# avoid intermittent "Unable to locate credentials" errors.
AWS_METADATA_SERVICE_TIMEOUT=5
AWS_METADATA_SERVICE_NUM_ATTEMPTS=3

# ── Athena ────────────────────────────────────────────────────
ATHENA_BRONZE_DB=tg-deltalake-bronze
ATHENA_SILVER_DB=tg-deltalake-silver
ATHENA_MASTER_DB=tg-master
ATHENA_OUTPUT_S3=s3://tg-temp-data/athena-results/datalake-agent/
# The agent's own workgroup: a 50 GB per-query scan cutoff, enforced, results
# in the output location above. Not `primary`, which is shared with the
# reporting pipelines. A query the cutoff stops is reported to the agent with
# how to narrow it; usage shows beside the model picker.
ATHENA_WORKGROUP=datalake-agent
# Athena data one chat may scan before the user is asked whether to continue
# (Chainlit) or must clear the conversation (Streamlit). 0 = no budget.
# ATHENA_SESSION_SCAN_BUDGET_GB=50

# ── App behaviour ─────────────────────────────────────────────
# Set to "false" to disable live Athena execution (dry-run mode)
EXECUTE_LIVE=true
# Largest result (its CSV in S3) offered as a download; larger ones show the
# 100-row preview only. Excel stops at 10 MB, as it is slow to build.
# DOWNLOAD_MAX_MB=100

# ── Authentication ────────────────────────────────────────────
# Shared password for the login screen.
# Users must also have a @tunedglobal.com email address.
# Change this to something strong before sharing with the team.
APP_PASSWORD=changeme

# ── Chainlit ──────────────────────────────────────────────────
# Required whenever sign-in is enabled (it always is). Signs the session
# cookie; changing it signs everyone out. Generate with:  chainlit create-secret
CHAINLIT_AUTH_SECRET=
# Google Workspace SSO. Leave empty to use the shared-password login only.
# The OAuth client's redirect URI must be <CHAINLIT_URL>/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# External base URL, needed behind a proxy for the OAuth redirect.
# CHAINLIT_URL=http://localhost:8000
# Chat history, favourites and usage, as a SQLAlchemy async URL.
# Local development uses Postgres in Docker:
#   docker compose --profile local-db up -d chat-db
#   CHAT_DB_URL=postgresql+asyncpg://datalake:datalake_local@localhost:5432/datalake_chat
# Production: TODO (see ROADMAP.md). Unset = SQLite at data/chat_history.db;
# "off" = no history.
# CHAT_DB_URL=
# Chats that aren't favourites (the Favourite button) are deleted after this many
# days without activity. 0 keeps everything.
# CHAT_RETENTION_DAYS=60
# Most favourite chats one user may keep, as favourites are never deleted.
# 0 = no cap.
# FAVOURITES_MAX=20
# Most questions one chat may hold; then the user starts a new chat. 0 = no cap.
# CHAT_MAX_QUESTIONS=25

# ── NOT A SETTING — a warning ─────────────────────────────────
# There is a local-development flag, DEV_SKIP_AUTH, that skips the login
# screen entirely. It is deliberately absent from this template: it belongs
# ONLY in a developer's own .env on their own machine.
#
# NEVER add DEV_SKIP_AUTH to a .env on a server. The app refuses it when
# running in a container and shows an error instead of signing anyone in,
# but do not rely on that — just don't put it here.
