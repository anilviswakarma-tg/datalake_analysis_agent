# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Virtual environments (machine-specific — never commit) ────
.venv/
venv/
env/
ENV/
myenv/

# ── Local config / secrets (use .env.example as the template) ─
.env
*.env
!.env.example
# Streamlit secrets — match at any depth (repo root has no leading-slash anchor issue)
secrets.toml
**/.streamlit/secrets.toml

# ── OS / editor cruft ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ── Chainlit ──────────────────────────────────────────────────
# Local upload/element scratch space.
.files/
# Regenerated by Chainlit on startup when missing.
app/.chainlit/translations/

# ── Chat history (SQLite by default; a Docker volume when deployed) ──
app/data/
